{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scarlet-guardian",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "cfda786a82241adf6b21f772dbc87544",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "scarlet.fortunestudios.jp",
      "zone_name": "fortunestudios.jp",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scarlet-guardian",
      "database_id": "929a0cd6-c09d-4c5e-9484-f5d3aeeba2e7"
    }
  ]
}
